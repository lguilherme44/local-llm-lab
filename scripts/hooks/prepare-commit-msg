#!/usr/bin/env python3
"""
Gera o subject do commit com o LLM local, a partir do diff staged.

Instalar (uma vez por clone):
    git config core.hooksPath scripts/hooks

Vive aqui e não em .git/hooks porque .git/hooks não é versionado: a versão
anterior deste hook se perdia em qualquer clone novo e ninguém sabia que ela
existia.

Falhas conhecidas da versão anterior, corrigidas aqui:

1. Prepender sobre mensagem já escrita. `COMMIT_SOURCE` é "message" quando se
   usa -m ou -F, e "message" não estava na lista de skip. Resultado: subject
   duplicado, com o palpite do modelo acima do texto do autor.

2. Falhar em silêncio. Com o servidor fora do ar o `except: pass` deixava o
   arquivo vazio e o git respondia "Aborting commit due to empty commit
   message" — erro que não menciona o modelo e manda o diagnóstico para o lado
   errado. Agora avisa no stderr e explica no corpo da mensagem.

3. Timeout fixo de 10s sem justificativa. Medido no MoE (ngl 99, cpu_moe 30):
   diff de 4 KB = 715 tokens de prompt, prefill 314 tok/s, 3.0s no total. 10s
   cobre, mas um perfil mais lento não — daí ser configurável.
"""

import json
import os
import subprocess
import sys
import urllib.error
import urllib.request

COMMIT_MSG_FILE = sys.argv[1]
COMMIT_SOURCE = sys.argv[2] if len(sys.argv) > 2 else ""

# "message" cobre -m e -F: nesses casos o autor já escreveu a mensagem.
if COMMIT_SOURCE in ("merge", "squash", "commit", "message"):
    sys.exit(0)

# Cinto e suspensório: qualquer linha não-comentário significa mensagem escrita.
try:
    with open(COMMIT_MSG_FILE, encoding="utf-8") as fh:
        if any(line.strip() and not line.startswith("#") for line in fh):
            sys.exit(0)
except OSError:
    sys.exit(0)


def warn(msg: str) -> None:
    print(f"prepare-commit-msg: {msg}", file=sys.stderr)


def annotate(note: str) -> None:
    """Deixa o motivo no corpo da mensagem, como comentário.

    Comentários não contam como mensagem, então o git continua exigindo que o
    autor escreva algo — mas agora ele sabe por quê.
    """
    try:
        with open(COMMIT_MSG_FILE, "r+", encoding="utf-8") as fh:
            existing = fh.read()
            fh.seek(0, 0)
            fh.write(f"# [hook] {note}\n{existing}")
    except OSError:
        pass


try:
    staged_diff = subprocess.check_output(["git", "diff", "--cached"], text=True)
except (subprocess.CalledProcessError, OSError) as exc:
    warn(f"não consegui ler o diff staged: {exc}")
    sys.exit(0)

if not staged_diff.strip():
    sys.exit(0)

MAX_DIFF_CHARS = int(os.getenv("LOCAL_LLM_DIFF_CHARS", "4000"))
truncated = len(staged_diff) > MAX_DIFF_CHARS
if truncated:
    staged_diff = staged_diff[:MAX_DIFF_CHARS] + "\n...[diff truncado]"

sys.path.append(os.path.join(os.getcwd(), "scripts"))
try:
    from local_llm_config import get_config
    cfg = get_config()
    url, api_key, model = cfg["url"], cfg["key"], cfg["model"]
except Exception:                                            # noqa: BLE001
    url = os.getenv("LOCAL_LLM_URL",
                    "http://192.168.3.51:8080/v1/chat/completions")
    api_key = os.getenv("LOCAL_LLM_KEY", "local")
    model = os.getenv("LOCAL_LLM_MODEL", "moe")

SYSTEM_PROMPT = """Você é um especialista em Git e Conventional Commits.
Analise o diff staged e gere APENAS uma linha de mensagem de commit seguindo \
estritamente o padrão Conventional Commits (ex: feat(scope): description).
Não use aspas, não adicione explicações, apenas a mensagem final em inglês.
"""

payload = {
    "model": model,
    "messages": [
        {"role": "system", "content": SYSTEM_PROMPT},
        {"role": "user",
         "content": f"Gere a mensagem de commit para o seguinte diff:\n\n{staged_diff}"},
    ],
    "temperature": 0.1,
    "max_tokens": 100,
    # Modelos com reasoning (Qwen3.6) gastam max_tokens pensando e devolvem
    # `reasoning_content` em vez de `content`. Sem isto o hook recebe conteúdo
    # vazio e parece "o modelo não respondeu".
    "chat_template_kwargs": {"enable_thinking": False},
}

TIMEOUT = float(os.getenv("LOCAL_LLM_TIMEOUT", "30"))

req = urllib.request.Request(
    url, data=json.dumps(payload).encode("utf-8"), method="POST",
    headers={"Content-Type": "application/json",
             "Authorization": f"Bearer {api_key}"},
)

try:
    with urllib.request.urlopen(req, timeout=TIMEOUT) as resp:
        body = json.loads(resp.read().decode("utf-8"))
    message = (body["choices"][0]["message"].get("content") or "").strip()
except urllib.error.URLError as exc:
    warn(f"LLM local inacessível em {url} ({exc.reason}). "
         f"Escreva a mensagem à mão.")
    annotate(f"LLM local offline ({exc.reason}) — subject não foi gerado.")
    sys.exit(0)
except TimeoutError:
    warn(f"LLM local não respondeu em {TIMEOUT:.0f}s. "
         f"Ajuste com LOCAL_LLM_TIMEOUT.")
    annotate(f"LLM local excedeu {TIMEOUT:.0f}s — subject não foi gerado.")
    sys.exit(0)
except (KeyError, ValueError, OSError) as exc:
    warn(f"resposta inesperada do LLM local: {type(exc).__name__}: {exc}")
    annotate("resposta inesperada do LLM local — subject não foi gerado.")
    sys.exit(0)

message = message.strip('"').strip("'").strip("`").strip()
# Uma linha só: se o modelo devolveu parágrafo, fica a primeira linha útil.
message = next((ln.strip() for ln in message.splitlines() if ln.strip()), "")

if not message:
    warn("o LLM local devolveu conteúdo vazio.")
    annotate("LLM local devolveu vazio — subject não foi gerado.")
    sys.exit(0)

try:
    with open(COMMIT_MSG_FILE, "r+", encoding="utf-8") as fh:
        existing = fh.read()
        fh.seek(0, 0)
        note = "# [hook] subject gerado pelo LLM local; revise antes de aceitar.\n"
        if truncated:
            note += f"# [hook] diff truncado em {MAX_DIFF_CHARS} chars.\n"
        fh.write(f"{message}\n\n{note}{existing}")
except OSError as exc:
    warn(f"não consegui escrever a mensagem: {exc}")
